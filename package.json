{
  "name": "sara-chat-voice-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/server.ts",
    "spike:replay": "node --env-file-if-exists=.env --import tsx scripts/pi-replay-spike.mjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.6.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@hono/node-server": "2.1.11",
    "better-sqlite3": "13.2.0",
    "hono": "4.13.19"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typebox": "1.4.7",
    "typescript": "5.9.3"
  }
}
