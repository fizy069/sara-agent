# Chat and memory for both text and voice.
SARA_MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
SARA_CHAT_REASONING=none

# Chat and voice use half this target for the conversation. Match it to Ollama's configured context.
SARA_CHAT_CONTEXT_WINDOW=4096

# Optional model overrides. Ollama defaults to qwen3.5:9b for both.
# SARA_CHAT_MODEL=qwen3.5:9b
# SARA_MEMORY_MODEL=qwen3.5:9b

# For OpenAI, set SARA_MODEL_PROVIDER=openai and fill in OPENAI_API_KEY.
# OpenAI defaults to gpt-6.1-terra for chat and gpt-6-luna for memory.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Finance lookup uses Ollama with qwen3-embedding:0.6b for either chat provider.
SARA_FINANCE_DB_PATH=data/finance.sqlite

HOST=127.0.0.1
PORT=3000
SARA_DB_PATH=data/sara.sqlite

# Browser calls use LiveKit with Silero voice activity detection.
# Set a shared token for the backend and worker to enable calls.
SARA_AGENT_TOKEN=
# LIVEKIT_URL=ws://127.0.0.1:7880
# Set these for a LiveKit server with custom credentials.
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# SARA_BACKEND_URL=http://127.0.0.1:3000

# Local voice on macOS uses Whisper for transcription and Tara for synthesis.
# SARA_SPEECH_PROVIDER=local
# SARA_TTS_PROVIDER=local
# SARA_WHISPER_MODEL=data/models/ggml-small-q5_1.bin
# SARA_WHISPER_BIN=whisper-cli
# Optional preloaded Whisper server on the same host. Keep the CLI and model for fallback.
# SARA_WHISPER_SERVER_URL=http://127.0.0.1:8090

# Hosted voice uses Sarvam Saaras v3 for transcription and Bulbul v4 Flash for synthesis.
# Uncomment both provider settings to match the hosted setup. When unset, TTS follows STT.
# SARA_SPEECH_PROVIDER=sarvam
# SARA_TTS_PROVIDER=sarvam
SARVAM_API_KEY=
# SARVAM_TTS_SPEAKER=ishita_enhi_customer
