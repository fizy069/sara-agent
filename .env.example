SARA_MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
SARA_CHAT_REASONING=none

# Optional Ollama model overrides.
# SARA_CHAT_MODEL=qwen3.5:9b
# SARA_MEMORY_MODEL=qwen3.5:9b
# SARA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Used with SARA_MODEL_PROVIDER=openai.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

HOST=127.0.0.1
PORT=3000
SARA_DB_PATH=data/sara.sqlite

# Browser calls. Set a shared token for the backend and worker to enable them.
# SARA_AGENT_TOKEN=
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
# SARA_BACKEND_URL=http://127.0.0.1:3000
# SARA_SPEECH_PROVIDER=local
# SARA_WHISPER_MODEL=data/models/ggml-small-q5_1.bin
# SARA_WHISPER_BIN=whisper-cli

# Optional speech provider. Set SARA_SPEECH_PROVIDER=sarvam and add its key.
# SARVAM_API_KEY=
